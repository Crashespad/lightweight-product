  "api_contract": [
    {
      "method": "GET",
      "path": "/api/metrics",
      "response": "[{active_products, total_grants, active_grants, revoked_grants}]",
      "description": "Returns key performance metrics for the dashboard."
    },
    {
      "method": "GET",
      "path": "/api/products",
      "response": "[{id, name, created_at}]",
      "description": "Lists all products associated with the vendor."
    },
    {
      "method": "POST",
      "path": "/api/products",
      "response": "{id, name}",
      "description": "Creates a new product."
    },
    {
      "method": "GET",
      "path": "/api/bonus_files",
      "response": "[{id, product_id, name, size, uploaded_at}]",
      "description": "Lists all bonus files for a product."
    },
    {
      "method": "POST",
      "path": "/api/bonus_files",
      "response": "{id, product_id, name, size}",
      "description": "Uploads a bonus file."
    },
    {
      "method": "GET",
      "path": "/api/claim_pages",
      "response": "[{id, product_id, url, slug}]",
      "description": "Gets all claim pages for a product."
    },
    {
      "method": "POST",
      "path": "/api/claim_pages",
      "response": "{id, product_id, url, slug}",
      "description": "Creates a new claim page."
    },
    {
      "method": "POST",
      "path": "/api/access_grants",
      "response": "{id, customer_id, product_id, granted_at, status}",
      "description": "Issues access to a bonus file for a customer."
    },
    {
      "method": "POST",
      "path": "/api/refunds",
      "response": "{id, customer_id, product_id, revoked_at}",
      "description": "Revokes access for a customer upon refund."
    }
  ],
